# OntoDB Production Configuration
# Copy this file to .env and edit as needed.

# ── OntoDB Server ────────────────────────────────────────────
# Ports exposed to host
ONTODB_HTTP_PORT=7912
ONTODB_TCP_PORT=7913

# Resource limits
ONTODB_MEMORY_LIMIT=2g
ONTODB_CPU_LIMIT=2.0

# Rate limiting (requests per minute)
ONTODB_RATE_LIMIT=300
ONTODB_BURST_SIZE=50

# ── Nginx TLS Proxy ──────────────────────────────────────────
HTTPS_PORT=443
HTTP_PORT=80

# Place your TLS certificates at:
#   deploy/nginx/certs/server.crt
#   deploy/nginx/certs/server.key
#
# For testing, generate a self-signed cert:
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout deploy/nginx/certs/server.key \
#     -out deploy/nginx/certs/server.crt \
#     -subj "/CN=localhost"

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# ── Backup ───────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7
