# OntoDB Production Configuration
# Copy this file to .env and edit as needed.

# ── OntoDB Server ────────────────────────────────────────────
# Ports exposed to host
ONTODB_HTTP_PORT=7912
ONTODB_TCP_PORT=7913
ONTODB_PG_PORT=5432

# Resource limits
ONTODB_MEMORY_LIMIT=2g
ONTODB_CPU_LIMIT=2.0

# Rate limiting (requests per minute)
ONTODB_RATE_LIMIT=300
ONTODB_BURST_SIZE=50

# ── Nginx TLS Proxy ──────────────────────────────────────────
HTTPS_PORT=443
HTTP_PORT=80

# Place your TLS certificates at:
#   deploy/nginx/certs/server.crt
#   deploy/nginx/certs/server.key
#
# For testing, generate a self-signed cert:
#   openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
#     -keyout deploy/nginx/certs/server.key \
#     -out deploy/nginx/certs/server.crt \
#     -subj "/CN=localhost"

# CORS allowed origins (comma-separated, or "*" for all — NOT recommended)
# Leave empty for same-origin only (default, most secure).
# Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Alertmanager email alerts (SMTP)
# Copy deploy/monitoring/alertmanager.yml.example to alertmanager.yml
# and fill in real values, OR set these env vars for docker compose auto-substitution.
ALERT_EMAIL=your_email@qq.com
SMTP_AUTH_PASSWORD=your_smtp_password

# ── Backup ───────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=7

# ── Sharding ─────────────────────────────────────────────────
# Enable data sharding (requires restart)
SHARDING_ENABLED=false

# Default shard ID for unsharded data
SHARDING_DEFAULT_SHARD=0

# Shard configuration file path (JSON format)
SHARDING_CONFIG_FILE=config/sharding.json

# Auto-rebalance when adding new shards
SHARDING_AUTO_REBALANCE=true

# Migration batch size (records per batch)
SHARDING_MIGRATION_BATCH_SIZE=1000

# Migration progress update interval (seconds)
SHARDING_MIGRATION_PROGRESS_INTERVAL=5

# Maximum concurrent migrations
SHARDING_MAX_CONCURRENT_MIGRATIONS=2

# Shard health check interval (seconds)
SHARDING_HEALTH_CHECK_INTERVAL=30

# Enable shard splitting
SHARDING_SPLIT_ENABLED=true

# Maximum shards per split operation
SHARDING_MAX_SPLIT_SHARDS=4
