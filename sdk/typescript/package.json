{
  "name": "ontodb-ts",
  "version": "0.6.1",
  "description": "TypeScript compatibility wrapper for the OntoDB JavaScript SDK — prefer 'ontodb' for new projects",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "keywords": ["ontodb", "database", "graph", "vector", "sparql", "semantic", "typescript"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ontodb/ontodb"
  },
  "dependencies": {
    "ontodb": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
