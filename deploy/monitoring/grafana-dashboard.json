{
  "id": null,
  "uid": "ontodb-main",
  "title": "OntoDB Dashboard",
  "tags": ["ontodb", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Query Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ontodb_queries_total[5m])", "legendFormat": "total" },
        { "expr": "rate(ontodb_queries_by_type{type=\"select\"}[5m])", "legendFormat": "select" },
        { "expr": "rate(ontodb_queries_by_type{type=\"insert\"}[5m])", "legendFormat": "insert" },
        { "expr": "rate(ontodb_queries_by_type{type=\"update\"}[5m])", "legendFormat": "update" },
        { "expr": "rate(ontodb_queries_by_type{type=\"delete\"}[5m])", "legendFormat": "delete" },
        { "expr": "rate(ontodb_queries_by_type{type=\"vector_search\"}[5m])", "legendFormat": "vector" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 2,
      "title": "Query Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(ontodb_query_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(ontodb_query_duration_seconds_bucket[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(ontodb_query_duration_seconds_bucket[5m]))", "legendFormat": "p99" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 3,
      "title": "Active Connections",
      "type": "timeseries",
      "targets": [
        { "expr": "ontodb_http_connections_active", "legendFormat": "HTTP" },
        { "expr": "ontodb_tcp_connections_active", "legendFormat": "TCP" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },
    {
      "id": 4,
      "title": "Errors",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ontodb_query_errors_total[5m])", "legendFormat": "query errors/s" },
        { "expr": "rate(ontodb_parse_errors_total[5m])", "legendFormat": "parse errors/s" },
        { "expr": "rate(ontodb_auth_failures_total[5m])", "legendFormat": "auth failures/s" },
        { "expr": "rate(ontodb_rate_limited_total[5m])", "legendFormat": "rate limited/s" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 5,
      "title": "Slow Queries",
      "type": "stat",
      "targets": [
        { "expr": "ontodb_slow_queries_total", "legendFormat": "Total" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 10, "color": "yellow" }, { "value": 100, "color": "red" }] }
        }
      }
    },
    {
      "id": 6,
      "title": "Memory Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "ontodb_memory_usage_bytes", "legendFormat": "RSS" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
    },
    {
      "id": 7,
      "title": "Disk Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "ontodb_disk_usage_bytes", "legendFormat": "Total disk" },
        { "expr": "ontodb_wal_size_bytes", "legendFormat": "WAL" },
        { "expr": "ontodb_memtable_size_bytes", "legendFormat": "MemTable" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 8,
      "title": "Storage Engine",
      "type": "timeseries",
      "targets": [
        { "expr": "ontodb_sstable_count", "legendFormat": "SSTables" },
        { "expr": "ontodb_storage_entries", "legendFormat": "Entries" },
        { "expr": "ontodb_compaction_pending", "legendFormat": "Pending compactions" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 9,
      "title": "Block Cache",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ontodb_block_cache_hits_total[5m])", "legendFormat": "hits/s" },
        { "expr": "rate(ontodb_block_cache_misses_total[5m])", "legendFormat": "misses/s" },
        { "expr": "rate(ontodb_block_cache_evictions_total[5m])", "legendFormat": "evictions/s" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 10,
      "title": "WAL & Transactions",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(ontodb_wal_writes_total[5m])", "legendFormat": "WAL writes/s" },
        { "expr": "ontodb_active_transactions", "legendFormat": "Active txns" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 11,
      "title": "Raft State",
      "type": "stat",
      "targets": [
        { "expr": "ontodb_raft_state", "legendFormat": "State" }
      ],
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Follower", "color": "blue" } } },
            { "type": "value", "options": { "1": { "text": "Leader", "color": "green" } } },
            { "type": "value", "options": { "2": { "text": "Candidate", "color": "yellow" } } },
            { "type": "value", "options": { "3": { "text": "Standalone", "color": "text" } } }
          ]
        }
      }
    },
    {
      "id": 12,
      "title": "Raft Log Lag",
      "type": "stat",
      "targets": [
        { "expr": "ontodb_raft_log_lag", "legendFormat": "Entries behind" }
      ],
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 100, "color": "yellow" }, { "value": 1000, "color": "red" }] }
        }
      }
    },
    {
      "id": 13,
      "title": "Backup Status",
      "type": "stat",
      "targets": [
        { "expr": "ontodb_last_backup_size_bytes", "legendFormat": "Size" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 14,
      "title": "Uptime",
      "type": "stat",
      "targets": [
        { "expr": "ontodb_uptime_seconds", "legendFormat": "Uptime" }
      ],
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 15,
      "title": "Open File Descriptors",
      "type": "gauge",
      "targets": [
        { "expr": "ontodb_open_file_descriptors", "legendFormat": "FDs" }
      ],
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 32 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "steps": [{ "value": null, "color": "green" }, { "value": 500, "color": "yellow" }, { "value": 1000, "color": "red" }] }
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s"
}
