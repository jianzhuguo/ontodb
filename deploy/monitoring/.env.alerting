# OntoDB 告警通知配置
#
# 使用方法：
#   1. 根据你使用的渠道，填写对应的配置
#   2. 重启服务: docker compose restart alertmanager dingtalk wechat-webhook
#   3. 测试告警: curl -X POST http://localhost:9093/api/v1/alerts -d '...'
#
# 最少配置一个渠道即可收到告警

# ── 邮件 (SMTP) ──────────────────────────────────────────────
# 填入后修改 alertmanager.yml 中的 email_configs 部分
#
# Gmail:       smtp.gmail.com:587, 需开启"应用专用密码"
# QQ 邮箱:     smtp.qq.com:587, 需开启 SMTP 并获取授权码
# 163 邮箱:    smtp.163.com:465, 需开启 SMTP
# 企业邮箱:    按企业邮箱服务商文档配置

# ── Slack ─────────────────────────────────────────────────────
# 1. 进入 https://api.slack.com/apps → Create New App
# 2. 选 Incoming Webhooks → Activate
# 3. Add New Webhook to Workspace → 选频道
# 4. 复制 Webhook URL 填入 alertmanager.yml

# ── 钉钉 ─────────────────────────────────────────────────────
# 1. 钉钉群 → 群设置 → 智能群助手 → 添加机器人
# 2. 选"自定义(通过Webhook接入)"
# 3. 设置机器人名称: OntoDB告警
# 4. 安全设置选"加签"，复制 SEC... 密钥
# 5. 复制 Webhook 地址中的 access_token
# 6. 填入下方 DINGTALK_ACCESS_TOKEN 和 DINGTALK_SECRET
# 7. 修改 dingtalk-config.yml 中的 url

DINGTALK_ACCESS_TOKEN=your-access-token-here
DINGTALK_SECRET=SEC-your-sign-secret-here

# ── 企业微信 ─────────────────────────────────────────────────
# 方式1: 群机器人 (推荐，简单)
#   1. 企业微信群 → 群设置 → 群机器人 → 添加
#   2. 复制 Webhook URL 中的 key
#   3. 直接在 alertmanager.yml 的 webhook_configs 中替换 URL
#
# 方式2: 应用消息 (需要企业微信管理员权限)
#   1. 企业微信管理后台 → 应用管理 → 创建应用
#   2. 获取 CorpID、Secret、AgentID
#   3. 填入下方配置

WECHAT_CORP_ID=your-corp-id
WECHAT_CORP_SECRET=your-corp-secret
WECHAT_AGENT_ID=your-agent-id
WECHAT_TO_USER=@all
