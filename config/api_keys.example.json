{
  "enabled": true,
  "keys": [
    {
      "key": "CHANGE_ME_ADMIN_KEY_HERE",
      "description": "Admin key with full access",
      "permission": "Admin",
      "rate_limit": 120
    },
    {
      "key": "CHANGE_ME_READONLY_KEY_HERE",
      "description": "Read-only access for dashboards",
      "permission": "ReadOnly",
      "rate_limit": 30
    },
    {
      "key": "CHANGE_ME_APP_KEY_HERE",
      "description": "Application read-write access",
      "permission": "ReadWrite",
      "rate_limit": 60
    }
  ],
  "default_permission": "ReadOnly"
}
