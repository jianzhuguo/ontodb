# ============================================================
# 金融风控规则集 — 业务专家直接编写，无需编程
# ============================================================
# 使用方法：
#   1. 将此文件保存为 .dsl 格式
#   2. 放入 OntoDB 的 rules/ 目录
#   3. 规则自动生效，无需重启数据库
#   4. 修改此文件后自动热更新
# ============================================================

# 规则1：大额交易预警
RULE: 大额交易预警
ID: risk_001
WHEN:
    交易.金额 > 500000
THEN:
    交易.风险等级 = "高"
    通知.级别 = "紧急"
    审计.标记 = "大额交易"
PRIORITY: 紧急
ENABLED: true

# 规则2：高频交易检测
RULE: 高频交易检测
ID: risk_002
WHEN:
    账户.日交易次数 > 50
    账户.日交易金额 > 1000000
THEN:
    账户.风险等级 = "可疑"
    通知.级别 = "高"
    审计.标记 = "高频交易"
PRIORITY: 高
ENABLED: true

# 规则3：异常时间交易
RULE: 异常时间交易
ID: risk_003
WHEN:
    交易.时间 > 23
    交易.金额 > 10000
THEN:
    交易.风险等级 = "中"
    通知.级别 = "中"
    审计.标记 = "异常时间"
PRIORITY: 中
ENABLED: true

# 规则4：关联交易检测
RULE: 关联账户转账
ID: risk_004
WHEN:
    交易.类型 = "转账"
    交易.金额 > 200000
    账户.关联账户数 > 3
THEN:
    交易.风险等级 = "高"
    通知.级别 = "高"
    审计.标记 = "关联交易"
PRIORITY: 高
ENABLED: true

# 规则5：洗钱风险检测
RULE: 洗钱风险检测
ID: risk_005
WHEN:
    账户.日交易次数 > 20
    账户.单笔金额 < 50000
    账户.日总金额 > 500000
THEN:
    账户.风险等级 = "极高"
    通知.级别 = "紧急"
    审计.标记 = "疑似洗钱"
PRIORITY: 紧急
ENABLED: true

# 规则6：正常交易放行
RULE: 正常交易
ID: risk_006
WHEN:
    交易.金额 < 10000
    交易.时间 > 8
    交易.时间 < 18
THEN:
    交易.风险等级 = "低"
    审计.标记 = "正常"
PRIORITY: 低
ENABLED: true
